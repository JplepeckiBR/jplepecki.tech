---
// Signature element: a live-looking procedural gait-pressure waveform.
// - Pure canvas, no deps. Pauses when off-screen (IntersectionObserver).
// - Static single frame under prefers-reduced-motion.
// - Degrades to a static SVG baseline if JS is disabled (the <canvas> simply
//   stays empty but the figure keeps its height, so there's no layout shift).
---

<figure class="trace" aria-hidden="true">
  <canvas class="trace-canvas" data-sensor-trace></canvas>
  <figcaption class="trace-meta label">
    <span>CH0 · GAIT PRESSURE</span>
    <span class="trace-live" data-trace-live>● LIVE</span>
  </figcaption>
</figure>

<style>
  .trace {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 16 / 6;
    background: var(--bg-inset);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .trace-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .trace-meta {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3) var(--space-2);
    pointer-events: none;
    /* Scrim so the label stays legible over the waveform without hiding it. */
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-inset) 92%, transparent),
      transparent
    );
  }
  .trace-live {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .trace-live {
      display: none;
    }
  }
</style>

<script>
  const PAD = 2;
  type Ctx = CanvasRenderingContext2D;

  function cssVar(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  function initTrace(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0;
    let h = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let t = 0;
    let raf = 0;
    let visible = true;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.floor(rect.width));
      h = Math.max(1, Math.floor(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // A gait-like pressure signal: a sharp heel strike + toe-off bump per step,
    // with light jitter. Deterministic given phase, so it reads as a real trace.
    function sample(x: number, phase: number): number {
      const p = ((x / w) * 2.4 + phase) % 1; // step period across the width
      // heel strike (narrow tall peak) + toe-off (lower broad peak)
      const heel = Math.exp(-Math.pow((p - 0.18) / 0.06, 2));
      const toe = 0.6 * Math.exp(-Math.pow((p - 0.52) / 0.12, 2));
      const base = heel + toe;
      const jitter = 0.04 * Math.sin(x * 0.4 + phase * 40);
      return base + jitter;
    }

    function draw() {
      const line = cssVar('--line', '#2b2d36');
      const accent = cssVar('--accent', '#ff5a1f');
      ctx!.clearRect(0, 0, w, h);

      // grid
      ctx!.strokeStyle = line;
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      for (let gx = 0; gx <= w; gx += Math.max(24, w / 16)) {
        ctx!.moveTo(gx + 0.5, 0);
        ctx!.lineTo(gx + 0.5, h);
      }
      for (let gy = 0; gy <= h; gy += Math.max(20, h / 5)) {
        ctx!.moveTo(0, gy + 0.5);
        ctx!.lineTo(w, gy + 0.5);
      }
      ctx!.stroke();

      // waveform
      const phase = t * 0.12;
      const top = PAD;
      const bottom = h - PAD;
      const amp = (bottom - top) * 0.9;
      ctx!.beginPath();
      for (let x = 0; x <= w; x += 2) {
        const y = bottom - sample(x, phase) * amp * 0.85;
        if (x === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.strokeStyle = accent;
      ctx!.lineWidth = 2;
      ctx!.lineJoin = 'round';
      ctx!.stroke();
    }

    function loop() {
      t += 1;
      draw();
      if (visible && !reduce) raf = requestAnimationFrame(loop);
    }

    resize();
    draw(); // always paint at least one frame (also the reduced-motion frame)

    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          visible = entries[0]?.isIntersecting ?? false;
          if (visible && !raf) {
            raf = requestAnimationFrame(loop);
          } else if (!visible && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        },
        { threshold: 0 }
      );
      io.observe(canvas);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        draw();
      }, 150);
    });
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-sensor-trace]')
    .forEach((c) => initTrace(c));
</script>
