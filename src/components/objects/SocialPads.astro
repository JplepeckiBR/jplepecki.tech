---
// Social links drawn as through-hole solder pads: a copper ring on dark board,
// the icon etched inside. Labels live in aria-label/title, not on the board.
import { SOCIAL_LINKS, type SocialIcon } from '../../config/site';

interface Props {
  size?: 'sm' | 'md';
  tone?: 'board' | 'bare';
  class?: string;
}

const { size = 'md', tone = 'board', class: className } = Astro.props;
const isExternal = (href: string) => href.startsWith('https://');
const icons: Record<SocialIcon, string> = {
  linkedin:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.8V16.5"/><circle cx="8" cy="7.9" r=".6" fill="currentColor"/><path d="M11.6 16.5v-5.7M11.6 13.4c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6v3.1"/>',
  x: '<path d="M4.4 4.5h4.1l11.1 15h-4.1z" fill="currentColor" stroke="none"/><path d="M19.2 4.5 13.4 11M10.6 13 4.8 19.5"/>',
  github:
    '<path d="M9.2 19.6v-2.4c-2.8.6-3.3-1.3-3.3-1.3M14.8 19.6v-2.7c0-.8-.3-1.3-.7-1.6 2.3-.3 4.3-1.1 4.3-4.6 0-1-.4-1.9-1-2.5.1-.3.4-1.3-.1-2.6 0 0-.8-.3-2.6 1a9 9 0 0 0-4.8 0C8.1 4 7.3 4.3 7.3 4.3c-.5 1.3-.2 2.3-.1 2.6-.6.6-1 1.5-1 2.5 0 3.5 2 4.3 4.3 4.6-.3.3-.6.7-.7 1.3"/>',
  email: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 6.5 8 6.2 8-6.2"/>',
};
---

<ul class:list={['social-pads', `social-pads--${size}`, `social-pads--${tone}`, className]} aria-label="Find me elsewhere">
  {SOCIAL_LINKS.map((link) => (
    <li>
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        rel={isExternal(link.href) ? 'me noopener' : undefined}
        target={isExternal(link.href) ? '_blank' : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[link.icon]} />
      </a>
    </li>
  ))}
</ul>

<style>
  .social-pads {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 6px;
    list-style: none;
  }

  .social-pads a {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--text);
    text-decoration: none;
  }

  .social-pads svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  /* A pad: copper annular ring with a dark drill field, like an unpopulated through-hole footprint. */
  .social-pads--board a {
    position: relative;
    border-radius: 7px;
  }

  .social-pads--board a::before {
    position: absolute;
    inset: 4px;
    content: '';
    border: 2px solid var(--copper);
    border-radius: 5px;
    background: var(--pcb);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5), 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: background 140ms ease, border-color 140ms ease;
  }

  .social-pads--board svg { position: relative; }

  .social-pads--board a:hover::before,
  .social-pads--board a:focus-visible::before {
    border-color: var(--accent);
    background: var(--copper);
  }

  .social-pads--board a:hover,
  .social-pads--board a:focus-visible { color: var(--ink); }

  .social-pads--sm svg { width: 17px; height: 17px; }

  .social-pads--bare a { color: var(--text-muted); }
  .social-pads--bare a:hover,
  .social-pads--bare a:focus-visible { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .social-pads--board a::before { transition: none; }
  }
</style>
