---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { clampNumber, clampRotation, cleanHref, cleanText, isImageMetadata } from './_shared';

interface Props {
  href: string;
  image?: ImageMetadata;
  alt?: string;
  linkLabel?: string;
  actionLabel?: string;
  rotation?: number;
  width?: number;
}

const {
  href,
  image,
  alt,
  linkLabel,
  actionLabel = 'current build →',
  rotation = -3,
  width = 210,
} = Astro.props;
const safeHref = cleanHref(href);
const safeAlt = cleanText(alt);
const safeLinkLabel = cleanText(linkLabel);
const safeActionLabel = cleanText(actionLabel);
const safeRotation = clampRotation(rotation, -3);
const safeWidth = clampNumber(width, 180, 420, 210);
const canRender = Boolean(safeHref && safeAlt && safeLinkLabel) && isImageMetadata(image);
---

{
  canRender && image && (
    <a
      class="sketch-card"
      href={safeHref}
      aria-label={safeLinkLabel}
      style={`--object-rotation:${safeRotation}deg;--object-width:${safeWidth}px`}
    >
      <span class="sketch-card__paper">
        <svg class="sketch-card__grid" viewBox="0 0 180 120" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <pattern id="sketch-grid" width="12" height="12" patternUnits="userSpaceOnUse">
              <path d="M12 0H0V12" />
            </pattern>
          </defs>
          <rect width="180" height="120" fill="url(#sketch-grid)" />
        </svg>
        <Image
          src={image}
          alt={safeAlt}
          width={image.width}
          height={image.height}
          loading="eager"
        />
      </span>
      {safeActionLabel && <span class="sketch-card__action">{safeActionLabel}</span>}
    </a>
  )
}

<style>
  .sketch-card {
    display: block;
    width: min(var(--object-width), 100%);
    min-height: 44px;
    text-decoration: none;
    transform: rotate(var(--object-rotation));
    transition: filter 160ms ease, transform 160ms ease;
  }

  .sketch-card:hover,
  .sketch-card:focus-visible {
    filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.48));
    transform: translateY(-4px) rotate(0);
  }

  .sketch-card__paper {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 12px;
    background: var(--paper-bright);
    box-shadow: var(--shadow-object);
  }

  .sketch-card__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sketch-card__grid path {
    fill: none;
    stroke: #d7dce4;
    stroke-width: 1;
  }

  .sketch-card__paper :global(img) {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  .sketch-card__action {
    display: block;
    margin-top: 8px;
    color: var(--text);
    font: 12px/1.4 var(--font-mono);
  }
</style>
