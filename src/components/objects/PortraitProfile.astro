---
// JP's profile on the desk: a riso print taped down, a copper-halftone test card
// tucked under its corner, a label-maker name tape and the socials as solder pads.
// Both prints are links to the post that explains them; with JavaScript they open
// the PortraitLightbox first.
import { PORTRAIT_POST_HREF, SITE_NAME } from '../../config/site';
import SocialPads from './SocialPads.astro';
import { clampNumber, clampRotation } from './_shared';

interface Props {
  variant?: 'desk' | 'compact';
  width?: number;
  rotation?: number;
}

const { variant = 'desk', width = 300, rotation = -1.5 } = Astro.props;
const safeWidth = clampNumber(width, 260, 360, 300);
const safeRotation = clampRotation(rotation, -1.5);
---

{variant === 'desk' ? (
  <div class="profile" style={`--profile-width:${safeWidth}px;--print-rotation:${safeRotation}deg`}>
    <a
      class="print print--riso"
      href={PORTRAIT_POST_HREF}
      data-portrait-open="riso"
      aria-label="Riso portrait of JP. Enlarge it and see how it was made"
    >
      <span class="print__tape" aria-hidden="true"></span>
      <img
        src="/portraits/jp-riso-440.png"
        srcset="/portraits/jp-riso-440.png 440w, /portraits/jp-riso-880.png 880w"
        sizes="206px"
        width="440"
        height="550"
        alt=""
        loading="eager"
      />
      <span class="print__meta" aria-hidden="true"><span>RISO · 2 COL · 1/30</span><span class="print__zoom">⤢</span></span>
    </a>

    <a
      class="print print--copper"
      href={PORTRAIT_POST_HREF}
      data-portrait-open="copper"
      aria-label="Copper halftone portrait of JP. Enlarge it and see how it was made"
    >
      <img
        src="/portraits/jp-copper-440.jpg"
        srcset="/portraits/jp-copper-440.jpg 440w, /portraits/jp-copper-840.jpg 840w"
        sizes="112px"
        width="440"
        height="550"
        alt=""
        loading="eager"
      />
      <span class="print__silk" aria-hidden="true">ART1 · CU</span>
      <span class="print__hole" aria-hidden="true"></span>
    </a>

    <span class="profile__hint" aria-hidden="true">↖ click to<br />enlarge</span>

    <div class="profile__id">
      <p class="dymo"><span class="visually-hidden">{SITE_NAME}</span><span aria-hidden="true">JP LEPECKI</span></p>
      <div class="profile__strip">
        <span class="profile__designator" aria-hidden="true">J5</span>
        <SocialPads size="sm" />
      </div>
    </div>
  </div>
) : (
  <section class="profile-compact" aria-label="About JP">
    <a
      class="profile-compact__print"
      href={PORTRAIT_POST_HREF}
      data-portrait-open="riso"
      aria-label="Riso portrait of JP. Enlarge it and see how it was made"
    >
      <span class="print__tape" aria-hidden="true"></span>
      <img
        src="/portraits/jp-riso-440.png"
        srcset="/portraits/jp-riso-440.png 440w, /portraits/jp-riso-880.png 880w"
        sizes="112px"
        width="440"
        height="550"
        alt=""
        loading="eager"
      />
      <span class="profile-compact__zoom" aria-hidden="true">⤢</span>
    </a>
    <div class="profile-compact__text">
      <p class="dymo"><span class="visually-hidden">{SITE_NAME}</span><span aria-hidden="true">JP LEPECKI</span></p>
      <p class="profile-compact__line">Embedded systems × data. Builds hardware, writes it up.</p>
      <SocialPads size="sm" />
    </div>
  </section>
)}

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- desk variant ---------- */
  .profile {
    position: relative;
    width: var(--profile-width);
    height: 452px;
  }

  .print {
    position: absolute;
    display: block;
    color: var(--text-on-paper);
    text-decoration: none;
    cursor: zoom-in;
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  }

  .print img {
    display: block;
    width: 100%;
    height: auto;
  }

  .print--riso {
    z-index: 2;
    top: 8px;
    left: 0;
    width: 234px;
    padding: 14px 14px 8px;
    background-color: #efeadd;
    background-image: var(--texture-paper);
    box-shadow: var(--shadow-object), var(--wear-paper);
    transform: rotate(var(--print-rotation));
  }

  .print__tape {
    position: absolute;
    z-index: 3;
    top: -9px;
    left: 38%;
    width: 72px;
    height: 20px;
    background: var(--tape);
    transform: rotate(2deg);
  }

  .print__meta {
    display: flex;
    margin-top: 7px;
    justify-content: space-between;
    color: #4a4d49;
    font: 10px/1.4 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .print__zoom {
    color: #4a4d49;
    font-size: 13px;
    line-height: 1;
    transition: color 160ms ease, transform 160ms ease;
  }

  .print--copper {
    z-index: 3;
    top: 176px;
    right: 0;
    width: 112px;
    padding: 8px 8px 20px;
    border-radius: 4px;
    background-color: var(--pcb);
    background-image: var(--texture-dark);
    box-shadow: var(--shadow-object), var(--wear-cover);
    transform: rotate(2.5deg);
  }

  .print--copper img { border-radius: 2px; }

  .print__silk {
    position: absolute;
    left: 9px;
    bottom: 4px;
    color: #d8d2c2;
    font: 8px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .print__hole {
    position: absolute;
    right: 7px;
    bottom: 5px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--copper);
    border-radius: 50%;
  }

  .print:hover,
  .print:focus-visible {
    z-index: 5;
    box-shadow: var(--shadow-page), var(--wear-paper);
    transform: translateY(-5px) rotate(0deg);
  }

  .print:hover .print__zoom,
  .print:focus-visible .print__zoom {
    color: var(--danger);
    transform: scale(1.25);
  }

  .profile__hint {
    position: absolute;
    top: 358px;
    left: 230px;
    width: 76px;
    color: var(--pencil);
    font: 12px/1.45 var(--font-mono);
    transform: rotate(-3deg);
    pointer-events: none;
  }

  .profile__id {
    position: absolute;
    top: 352px;
    left: 2px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
  }

  .profile__strip {
    display: flex;
    padding: 2px 6px 2px 10px;
    align-items: center;
    gap: 6px;
    border-radius: 6px;
    background-color: var(--pcb);
    background-image: var(--texture-dark);
    box-shadow: var(--shadow-object), var(--wear-cover);
    transform: rotate(0.8deg);
  }

  .profile__designator {
    color: #d8d2c2;
    font: 9px/1 var(--font-mono);
    letter-spacing: 0.08em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  /* Embossed label-maker tape: raised off-white letters on glossy black, angled cut ends. */
  .dymo {
    margin: 0;
    padding: 6px 16px 5px;
    background: #171717;
    color: #f2efe6;
    font: 700 14px/1 var(--font-mono);
    letter-spacing: 0.32em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35), 0 -1px 0 rgba(0, 0, 0, 0.7);
    clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 -2px 0 rgba(0, 0, 0, 0.5);
    filter: drop-shadow(var(--shadow-drop));
    transform: rotate(-1deg);
  }

  /* ---------- compact variant (phones and the tidy list view) ---------- */
  .profile-compact {
    display: flex;
    padding: 18px 16px;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--line);
    background-color: var(--mat);
    background-image: var(--texture-mat);
  }

  .profile-compact__print {
    position: relative;
    flex: 0 0 auto;
    width: 112px;
    padding: 8px 8px 6px;
    background-color: #efeadd;
    background-image: var(--texture-paper);
    box-shadow: var(--shadow-object), var(--wear-paper);
    cursor: zoom-in;
    transform: rotate(-2deg);
  }

  .profile-compact__print img { display: block; width: 100%; height: auto; }

  .profile-compact__print .print__tape { width: 46px; height: 14px; top: -6px; left: 30%; }

  .profile-compact__zoom {
    position: absolute;
    right: -10px;
    bottom: -10px;
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    font: 600 14px/1 var(--font-mono);
    box-shadow: var(--shadow-object);
  }

  .profile-compact__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .profile-compact__line {
    margin: 0;
    padding: 8px 10px;
    background-color: var(--paper);
    background-image: var(--texture-paper);
    color: var(--text-on-paper);
    font: 15px/1.35 var(--font-serif);
    box-shadow: var(--shadow-object);
  }

  .profile-compact .dymo { font-size: 13px; }

  @media (prefers-reduced-motion: reduce) {
    .print,
    .print__zoom { transition: none; }
    .print:hover,
    .print:focus-visible { transform: rotate(0deg); }
  }
</style>
