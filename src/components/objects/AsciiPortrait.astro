---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { clampNumber, clampRotation, cleanHref, cleanText, isImageMetadata } from './_shared';

interface Props {
  href: string;
  photo?: ImageMetadata;
  ascii?: string;
  alt?: string;
  linkLabel?: string;
  rotation?: number;
  width?: number;
}

const {
  href,
  photo,
  ascii,
  alt,
  linkLabel = 'About the maker',
  rotation = -2,
  width = 250,
} = Astro.props;
const safeHref = cleanHref(href);
const safeAscii = cleanText(ascii);
const safeAlt = cleanText(alt);
const safeLinkLabel = cleanText(linkLabel);
const safeRotation = clampRotation(rotation, -2);
const safeWidth = clampNumber(width, 180, 420, 250);
const canRender =
  Boolean(safeHref && safeAscii && safeAlt && safeLinkLabel) && isImageMetadata(photo);
---

{
  canRender && photo && (
    <a
      class="portrait"
      href={safeHref}
      aria-label={safeLinkLabel}
      style={`--object-rotation:${safeRotation}deg;--object-width:${safeWidth}px`}
    >
      <span class="portrait__paper">
        <span class="portrait__tape" aria-hidden="true"></span>
        <span class="portrait__media">
          <pre aria-hidden="true">{safeAscii}</pre>
          <Image
            class="portrait__photo"
            src={photo}
            alt={safeAlt}
            width={photo.width}
            height={photo.height}
            loading="eager"
          />
        </span>
        <span class="portrait__caption">fig. 1 · the maker</span>
      </span>
    </a>
  )
}

<style>
  .portrait {
    display: block;
    width: min(var(--object-width), 100%);
    min-height: 44px;
    color: var(--text-on-paper);
    text-decoration: none;
    filter: drop-shadow(var(--shadow-object));
    transform: rotate(var(--object-rotation));
    transform-origin: center;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .portrait:hover,
  .portrait:focus-visible {
    filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.48));
    transform: translateY(-4px) rotate(0);
  }

  .portrait__paper {
    position: relative;
    display: block;
    padding: 14px 14px 12px;
    background: var(--paper);
  }

  .portrait__tape {
    position: absolute;
    z-index: 2;
    top: -10px;
    left: 36%;
    width: 70px;
    height: 20px;
    background: var(--tape);
    transform: rotate(1deg);
  }

  .portrait__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 0.72;
    background: var(--paper);
  }

  .portrait pre {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    color: var(--text-on-paper);
    font: 8.5px/1 var(--font-mono);
    white-space: pre;
    transition: opacity 180ms ease;
  }

  .portrait__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .portrait__caption {
    display: block;
    margin-top: 10px;
    color: #3c403e;
    font: 11px/1.4 var(--font-mono);
  }

  @media (hover: hover) and (min-width: 1100px) {
    .portrait:hover .portrait__photo,
    .portrait:focus-visible .portrait__photo {
      opacity: 1;
    }

    .portrait:hover pre,
    .portrait:focus-visible pre {
      opacity: 0;
    }
  }
</style>
