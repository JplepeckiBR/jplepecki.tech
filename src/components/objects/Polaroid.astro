---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StickyNote from './StickyNote.astro';
import { clampNumber, clampRotation, cleanHref, cleanText } from './_shared';

interface StickyData {
  loop?: string | number;
  day?: number;
  length?: number;
  stage?: string;
  rotation?: number;
}

interface Props {
  href: string;
  image?: ImageMetadata;
  alt?: string;
  linkLabel?: string;
  actionLabel?: string;
  sticky?: StickyData;
  rotation?: number;
  width?: number;
}

const {
  href,
  image,
  alt,
  linkLabel,
  actionLabel,
  sticky,
  rotation = 2.5,
  width = 250,
} = Astro.props;
const safeHref = cleanHref(href);
const safeAlt = cleanText(alt);
const safeLinkLabel = cleanText(linkLabel);
const safeActionLabel = cleanText(actionLabel);
const safeRotation = clampRotation(rotation, 2.5);
const safeWidth = clampNumber(width, 180, 480, 250);
const canRender = Boolean(safeHref && safeAlt && safeLinkLabel && image);
---

{
  canRender && image && (
    <a
      class="polaroid"
      href={safeHref}
      aria-label={safeLinkLabel}
      style={`--object-rotation:${safeRotation}deg;--object-width:${safeWidth}px`}
    >
      <span class="polaroid__frame">
        <Image
          src={image}
          alt={safeAlt}
          width={image.width}
          height={image.height}
          loading="eager"
        />
      </span>
      {sticky && (
        <span class="polaroid__sticky" aria-hidden="true">
          <StickyNote {...sticky} />
        </span>
      )}
      {safeActionLabel && <span class="polaroid__action">{safeActionLabel}</span>}
    </a>
  )
}

<style>
  .polaroid {
    display: block;
    width: min(var(--object-width), 100%);
    min-height: 44px;
    text-decoration: none;
    transform: rotate(var(--object-rotation));
    transform-origin: center;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .polaroid:hover,
  .polaroid:focus-visible {
    filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.48));
    transform: translateY(-4px) rotate(0);
  }

  .polaroid__frame {
    display: block;
    padding: 12px 12px 30px;
    background: var(--paper);
    box-shadow: var(--shadow-object);
  }

  .polaroid__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .polaroid__sticky {
    position: absolute;
    bottom: 34px;
    left: -26px;
  }

  .polaroid__action {
    display: block;
    margin-top: 8px;
    color: var(--text);
    font: 12px/1.4 var(--font-mono);
    text-align: right;
  }
</style>
