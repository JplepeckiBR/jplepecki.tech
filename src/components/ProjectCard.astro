---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StatusLight from './StatusLight.astro';
import Tag from './Tag.astro';
import { dateRange } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
---

<article class="card">
  <a href={href} class="card-media" tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          width={800}
          height={420}
          loading="lazy"
        />
      ) : (
        <span class="card-nomedia label">NO COVER</span>
      )
    }
  </a>
  <div class="card-body">
    <StatusLight status={data.status} />
    <h3 class="card-title">
      <a href={href}>{data.title}</a>
    </h3>
    <p class="card-hook">{data.hook}</p>
    <p class="card-dates label">{dateRange(data.startDate, data.endDate)}</p>
    {
      data.stack.length > 0 && (
        <ul class="card-tags" aria-label="Stack">
          {data.stack.slice(0, 4).map((s) => (
            <li>
              <Tag tag={s} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease);
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card-media {
    display: block;
    aspect-ratio: 40 / 21;
    background: var(--bg-inset);
    border-bottom: var(--hairline) solid var(--line);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-nomedia {
    display: grid;
    place-items: center;
    height: 100%;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .card-title {
    font-size: var(--step-1);
    margin-top: var(--space-1);
  }
  .card-title a {
    color: var(--fg);
  }
  .card-title a:hover {
    color: var(--accent-link);
    text-decoration: none;
  }
  .card-hook {
    color: var(--fg-muted);
    font-size: var(--step-0);
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-1);
  }
</style>
