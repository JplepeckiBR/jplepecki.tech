---
// Lightweight click-to-load facade adapted from the archived portfolio.
interface Props {
  provider: 'youtube' | 'vimeo';
  videoId?: string;
  url?: string;
  title: string;
  poster?: string;
}

const { provider, videoId, url, title, poster: suppliedPoster } = Astro.props;

function resolveId(): string | null {
  if (videoId) return videoId;
  if (!url) return null;

  try {
    const parsed = new URL(url);
    const host = parsed.hostname.toLowerCase().replace(/^www\./, '');

    if (provider === 'youtube') {
      if (host === 'youtu.be') return parsed.pathname.split('/').filter(Boolean)[0] ?? null;
      if (host === 'youtube.com' || host === 'm.youtube.com') {
        return parsed.searchParams.get('v') ?? parsed.pathname.split('/').filter(Boolean).pop() ?? null;
      }
      return null;
    }

    if (host === 'vimeo.com' || host === 'player.vimeo.com') {
      return parsed.pathname.split('/').filter(Boolean).pop() ?? null;
    }
  } catch {
    return null;
  }

  return null;
}

const candidateId = resolveId();
const id =
  candidateId &&
  (provider === 'youtube'
    ? /^[A-Za-z0-9_-]{11}$/.test(candidateId)
    : /^\d+$/.test(candidateId))
    ? candidateId
    : null;
const embedSrc =
  id && provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?rel=0`
    : id && provider === 'vimeo'
      ? `https://player.vimeo.com/video/${id}`
      : null;
const poster = suppliedPoster ?? (id && provider === 'youtube' ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : null);
---

{
  embedSrc && (
    <div class="video" data-video-facade data-src={embedSrc} data-title={title}>
      <button class="video__play" type="button" aria-label={`Load video: ${title}`}>
        {poster ? (
          <img src={poster} alt="" width="480" height="360" loading="lazy" decoding="async" />
        ) : (
          <span class="video__poster" aria-hidden="true">
            <span>EXT VIDEO</span>
            <span>CLICK TO LOAD</span>
          </span>
        )}
        <span class="video__icon" aria-hidden="true">
          <svg viewBox="0 0 68 48" width="68" height="48">
            <rect width="68" height="48" rx="5" fill="#141817" fill-opacity="0.92" stroke="#C89B5C" />
            <path d="M28 16l16 8-16 8z" fill="#F5B841" />
          </svg>
        </span>
      </button>
    </div>
  )
}

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--copper);
    background: var(--pcb);
  }

  .video__play {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: var(--pcb);
    cursor: pointer;
  }

  .video__play:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -5px;
  }

  .video__play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition: opacity 160ms ease-out;
  }

  .video__play:hover img {
    opacity: 1;
  }

  .video__poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px;
    color: var(--text-muted);
    font: 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-align: left;
  }

  .video__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .video :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .video__play img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((element) => {
    const button = element.querySelector('button');
    button?.addEventListener(
      'click',
      () => {
        const src = element.dataset.src;
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = element.dataset.title ?? 'Video';
        iframe.allow =
          'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        element.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>
