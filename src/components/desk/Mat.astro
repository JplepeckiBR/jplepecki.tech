---
interface Props {
  height?: number;
  label?: string;
  class?: string;
}

const { height = 860, label = "Maker's desk", class: className } = Astro.props;
const safeHeight = Number.isFinite(height) ? Math.min(1400, Math.max(250, height)) : 860;
const rulerMarks = Array.from({ length: 13 }, (_, index) => index);
---

<section
  class:list={['desk-mat', 'mat', className]}
  style={`--mat-height: ${safeHeight}px`}
  aria-label={label}
>
  <div class="mat__ruler" aria-hidden="true">
    {rulerMarks.map((mark) => <span>{mark}</span>)}
  </div>

  <svg class="mat__guides" viewBox="0 0 1200 860" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 860L860 0" />
    <path class="mat__guide--soft" d="M240 860L736 0" />
  </svg>

  <slot />
</section>

<style>
  .mat {
    isolation: isolate;
    height: var(--mat-height);
    overflow: hidden;
    border-radius: 6px;
  }

  .mat__ruler {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    display: flex;
    height: 24px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 4px 10px 0;
    color: var(--text);
    font: 11px/1.25 var(--font-mono);
    opacity: 0.75;
    pointer-events: none;
  }

  .mat__guides {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .mat__guides path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    opacity: 0.28;
    vector-effect: non-scaling-stroke;
  }

  .mat__guides .mat__guide--soft {
    opacity: 0.18;
  }
</style>
